PORT=3000
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
DATABASE_URL="mysql://app:CHANGE_ME@localhost:3306/monorepo_app2"
# Path to the CA that signed the MySQL server certificate. Leave empty to skip TLS options.
DATABASE_SSL_CA_PATH=./certs/ca.pem
# Keep "true" in production. Use "false" only for a local server whose certificate does not list the host name.
DATABASE_SSL_VERIFY_HOSTNAME=true
